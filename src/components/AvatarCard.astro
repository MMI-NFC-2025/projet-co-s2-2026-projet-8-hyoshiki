---
const { avatar, name, role, description } = Astro.props;
---

<div class="flex flex-col items-center gap-3 text-center">
    {
        avatar ? (
            <img
                src={avatar.src}
                alt={name}
                class="h-24 w-24 object-cover"
                loading="lazy"
            />
        ) : (
            <div class="h-24 w-24 bg-black" aria-hidden="true" />
        )
    }
    <div class="space-y-1">
        <p class="font-title text-base">{name}</p>
        <p class="text-sm text-black/60">{role}</p>
    </div>
    <p class="text-sm leading-relaxed text-black/70">{description}</p>
</div>
