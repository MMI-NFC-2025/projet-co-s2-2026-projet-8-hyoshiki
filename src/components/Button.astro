---
const {
    href = "#",
    variant = "primary",
    size = "md",
    class: className = "",
} = Astro.props;

const base =
    "inline-flex items-center justify-center rounded-full font-semibold transition duration-200";
const variants = {
    primary:
        "bg-gradient-to-r from-blue to-purple text-white shadow-soft hover:opacity-90",
    ghost: "text-black hover:text-purple",
    outline: "border-2 border-blue text-black hover:bg-blue/10",
};
const sizes = {
    sm: "px-4 py-2 text-sm",
    md: "px-5 py-3 text-base",
    lg: "px-6 py-3.5 text-lg",
};
---

<a
    href={href}
    class={`${base} ${variants[variant] ?? variants.primary} ${sizes[size] ?? sizes.md} ${className}`}
>
    <slot />
</a>
