---
const {
    text,
    url,
    variant = "primary",
    size = "normal",
    icon,
    className,
    type,
} = Astro.props;

const baseClasses = "font-bold rounded-full transition-colors duration-300";

const sizeClasses = {
    normal: "py-3 px-6 text-lg",
    large: "py-4 px-8 text-xl",
};

const variantClasses = {
    primary: "bg-white text-cyan-400 hover:bg-gray-200",
    secondary: "bg-black bg-opacity-20 text-white hover:bg-opacity-30",
    white: "bg-white text-cyan-500 hover:bg-gray-100",
};

const Tag = url ? "a" : "button";
---

<Tag
    href={url}
    type={Tag === "button" ? type || "button" : undefined}
    class:list={[
        baseClasses,
        sizeClasses[size],
        variantClasses[variant],
        className,
        "flex items-center justify-center gap-2",
    ]}
>
    {icon && <iconify-icon icon={icon} class="text-2xl" />}
    <span>{text}</span>
</Tag>
