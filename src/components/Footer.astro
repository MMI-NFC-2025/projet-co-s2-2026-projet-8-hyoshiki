---
import logoOdysigne from "../assets/img/Logo_odysigne.svg";
---

<footer class="relative bg-blue text-white pt-10 pb-8 md:pt-12 md:pb-10 overflow-visible">
    <div class="pointer-events-none absolute left-0 top-0 w-full overflow-hidden" style="height:90px; transform: translateY(-55%);">
        <svg class="w-full h-full" viewBox="0 0 1200 160" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M0,80 C175,5 375,5 600,50 C825,95 1025,-10 1200,60 L1200,160 L0,160 Z" fill="var(--blue)"></path>
        </svg>
    </div>
    <div class="relative mx-auto max-w-6xl px-6 sm:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="mb-3 flex items-center gap-3">
                    <div class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-full bg-white">
                        <img src={logoOdysigne.src} alt="Logo Odysignes" class="h-10 w-10 object-contain" />
                    </div>
                    <h2 class="font-title text-2xl leading-none sm:text-3xl">Odysignes</h2>
                </div>
                <div class="mt-3 space-y-0 text-sm leading-5 text-white/90">
                    <p>Verguet-Bailly Matias</p>
                    <p>Kruger Konstance</p>
                    <p>Carnicer Matthis</p>
                    <p>MMI 1 A2</p>
                </div>
            </div>

            <div>
                <h3 class="mb-2 font-title text-lg uppercase tracking-wide sm:mb-4 sm:text-xl">Menu</h3>
                <ul class="space-y-1.5 text-sm leading-5 text-white/90 sm:space-y-2">
                    <li><a href="/a-propos" class="hover:underline">A propos</a></li>
                    <li><a href="#" class="hover:underline">FAQ</a></li>
                    <li><a href="/contact" class="hover:underline">Contacts</a></li>
                </ul>
            </div>

            <div>
                <h3 class="mb-2 font-title text-lg uppercase tracking-wide sm:mb-4 sm:text-xl">Contact</h3>
                <div class="space-y-0 text-sm leading-5 text-white/90 sm:space-y-0">
                    <p>Département MMI</p>
                    <p>4 Pl. Lucien Tharradin, 25200 Montbéliard</p>
                    <p>0123456789</p>
                    <p>matias.verguet--bailly@edu.univ-fcomte.fr</p>
                    <p>konstance.kruger@edu.univ-fcomte.fr</p>
                    <p>matthis.carnicer@edu.univ-fcomte.fr</p>
                </div>
            </div>

            <div>
                <h3 class="mb-2 font-title text-lg uppercase tracking-wide sm:mb-4 sm:text-xl">Mentions légales</h3>
                <p class="text-sm leading-5 text-white/90">
                    Projet réalisé en 2026 dans le cadre d'un exercice pédagogique au département MMI de Montbéliard.
                </p>
                <div class="mt-4">
                    <p class="mb-2 font-title text-base uppercase tracking-wide sm:mb-3 sm:text-lg">Nous suivre</p>
                    <div class="flex items-center gap-4 text-white sm:gap-5">
                        <a href="#" aria-label="Facebook" class="hover:opacity-80">
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current sm:h-7 sm:w-7" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.4-.1-2.7-.1-2.7 0-4.5 1.7-4.5 4.7V11H7v3h2.6v8h3.9z"/></svg>
                        </a>
                        <a href="#" aria-label="Instagram" class="hover:opacity-80">
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current sm:h-7 sm:w-7" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.8A5.2 5.2 0 1 1 6.8 13 5.2 5.2 0 0 1 12 7.8zm0 2a3.2 3.2 0 1 0 3.2 3.2A3.2 3.2 0 0 0 12 9.8zm6.3-3.8a1.2 1.2 0 1 1-1.2 1.2 1.2 1.2 0 0 1 1.2-1.2z"/></svg>
                        </a>
                        <a href="#" aria-label="YouTube" class="hover:opacity-80">
                            <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current sm:h-7 sm:w-7" aria-hidden="true"><path d="M21.8 8.1s-.2-1.4-.8-2c-.8-.9-1.8-.9-2.2-1C16 4.9 12 4.9 12 4.9h0s-4 0-6.8.2c-.4 0-1.4 0-2.2 1-.6.6-.8 2-.8 2S2 9.7 2 11.2v1.6c0 1.5.2 3.1.2 3.1s.2 1.4.8 2c.8.9 1.9.8 2.4 1C7.5 19.1 12 19.1 12 19.1s4 0 6.8-.2c.4 0 1.4 0 2.2-1 .6-.6.8-2 .8-2s.2-1.6.2-3.1v-1.6c0-1.5-.2-3.1-.2-3.1zM9.7 14.1V9.4l4.7 2.4-4.7 2.3z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>