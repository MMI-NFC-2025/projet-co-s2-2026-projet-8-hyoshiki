---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import FooterPromo from "../components/Footer.astro";

import logo from "../assets/img/logo.svg";
---

<Layout
	title="Odysignes - Contact"
	description="Contactez l'équipe Odysignes pour toute question ou demande."
>
	<div class="bg-white">
		<Header logoSrc={logo.src} />

		<main class="mx-auto mt-6 mb-8 max-w-6xl px-4 pb-16 pt-8 sm:px-6">
			<section class="text-center">
				<h1
					class="font-title text-4xl leading-none text-black sm:text-5xl"
				>
					UNE QUESTION ?
				</h1>
				<p
					class="mt-2 font-title text-2xl tracking-tight text-black/95 sm:text-3xl"
				>
					CONTACTEZ-NOUS
				</p>
			</section>

			<section class="mt-8">
				<form class="space-y-5">
					<div>
						<p class="mb-2 text-xl text-black">
							1. Votre nom complet
						</p>
						<div class="grid gap-4 sm:grid-cols-2">
							<input
								type="text"
								name="nom"
								placeholder="Nom"
								class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95"
							/>
							<input
								type="text"
								name="prenom"
								placeholder="Prenom"
								class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95"
							/>
						</div>
					</div>

					<div>
						<p class="mb-2 text-xl text-black">2. Adresse mail</p>
						<div
							class="flex items-center rounded-2xl bg-blue px-4 shadow-soft"
						>
							<span class="text-2xl text-white" aria-hidden="true"
								>✉</span
							>
							<input
								type="email"
								name="email"
								placeholder="Adresse mail"
								class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0"
							/>
						</div>
					</div>

					<div>
						<p class="mb-2 text-xl text-black">
							3. Numéro de téléphone
						</p>
						<div
							class="flex items-center rounded-2xl bg-blue px-4 shadow-soft"
						>
							<span class="text-2xl text-white" aria-hidden="true"
								>☎</span
							>
							<input
								type="tel"
								name="telephone"
								placeholder="Numéro de téléphone"
								class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0"
							/>
						</div>
					</div>

					<div>
						<textarea
							name="message"
							rows="5"
							placeholder="Votre message"
							class="min-h-40 w-full rounded-2xl border-0 bg-blue px-4 py-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95"
						></textarea>
					</div>

					<div class="flex justify-center">
						<button
							type="submit"
							class="rounded-2xl bg-blue px-4 py-2 font-title text-xl text-white shadow-soft transition hover:opacity-95"
						>
							Soumettre
						</button>
					</div>
				</form>
			</section>

			<hr class="my-10 border-black/80" />

			<section>
				<h2
					class="font-title text-4xl leading-none text-black sm:text-5xl"
				>
					COORDONNÉES
				</h2>

				<div
					class="mt-8 rounded-[1.8rem] bg-white p-5 shadow-soft ring-1 ring-black/5"
				>
					<div class="space-y-6 text-base text-black sm:text-lg">
						<div class="flex items-start gap-3">
							<span
								class="text-2xl leading-none"
								aria-hidden="true">✉</span
							>
							<p>odysigne@gmail.com</p>
						</div>
						<div class="flex items-start gap-3">
							<span
								class="text-2xl leading-none"
								aria-hidden="true">☎</span
							>
							<p>+33 6 84 95 15 36</p>
						</div>
						<div class="flex items-start gap-3">
							<span
								class="text-2xl leading-none"
								aria-hidden="true">📍</span
							>
							<p>4 Pl. Lucien Tharradin, 25200 Montbéliard</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<FooterPromo logoSrc={logo.src} />
	</div>
</Layout>
