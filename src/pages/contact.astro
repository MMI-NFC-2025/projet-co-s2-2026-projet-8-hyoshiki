---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro"; 

import logo from "../assets/img/logo.svg";
---

<Layout
	title="Odysignes - Contact"
	description="Contactez l'équipe Odysignes pour toute question ou demande."
>
	<div class="bg-white min-h-screen flex flex-col">
		<Header logoSrc={logo.src} />

		<!-- Ajout de flex-1 et w-full -->
		<main
			class="flex-1 mx-auto mt-6 mb-8 max-w-6xl w-full px-4 pb-16 pt-8 sm:px-6"
		>
			<!-- En-tête -->
			<section class="text-center mb-12">
				<h1
					class="font-title text-4xl leading-none text-black sm:text-5xl uppercase"
				>
					Une question ?
				</h1>
				<p
					class="mt-2 font-title text-2xl tracking-tight text-black/95 sm:text-3xl uppercase"
				>
					Contactez-nous
				</p>
			</section>

			<!-- Formulaire et Coordonnées en grille sur grand écran -->
			<div class="grid gap-12 lg:grid-cols-2 lg:gap-8 items-start">
				<!-- Section Formulaire -->
				<section>
					<form class="space-y-6">
						<!-- Nom complet -->
						<div>
							<label
								class="block mb-2 text-xl text-black font-medium"
							>
								1. Votre nom complet
							</label>
							<div class="grid gap-4 sm:grid-cols-2">
								<input
									type="text"
									name="nom"
									placeholder="Nom"
									required
									class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none transition focus:ring-2 focus:ring-indigo-300"
								/>
								<input
									type="text"
									name="prenom"
									placeholder="Prénom"
									required
									class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none transition focus:ring-2 focus:ring-indigo-300"
								/>
							</div>
						</div>

						<!-- Email -->
						<div>
							<label
								for="email"
								class="block mb-2 text-xl text-black font-medium"
							>
								2. Adresse mail
							</label>
							<div
								class="flex items-center rounded-2xl bg-blue px-4 shadow-soft focus-within:ring-2 focus-within:ring-indigo-300 transition"
							>
								<span
									class="text-2xl text-white"
									aria-hidden="true">✉</span
								>
								<input
									type="email"
									id="email"
									name="email"
									placeholder="Adresse mail"
									required
									class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0"
								/>
							</div>
						</div>

						<!-- Téléphone -->
						<div>
							<label
								for="telephone"
								class="block mb-2 text-xl text-black font-medium"
							>
								3. Numéro de téléphone
							</label>
							<div
								class="flex items-center rounded-2xl bg-blue px-4 shadow-soft focus-within:ring-2 focus-within:ring-indigo-300 transition"
							>
								<span
									class="text-2xl text-white"
									aria-hidden="true">☎</span
								>
								<input
									type="tel"
									id="telephone"
									name="telephone"
									placeholder="Numéro de téléphone"
									class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0"
								/>
							</div>
						</div>

						<!-- Message -->
						<div>
							<label for="message" class="sr-only"
								>Votre message</label
							>
							<textarea
								id="message"
								name="message"
								rows="5"
								required
								placeholder="Votre message..."
								class="min-h-[10rem] w-full rounded-2xl border-0 bg-blue px-4 py-4 text-white placeholder:text-white/70 shadow-soft outline-none transition focus:ring-2 focus:ring-indigo-300 resize-y"
							></textarea>
						</div>

						<!-- Bouton -->
						<div class="flex justify-center lg:justify-start">
							<button
								type="submit"
								class="rounded-2xl bg-blue px-8 py-3 font-title text-xl text-white shadow-soft transition-all hover:opacity-90 hover:scale-105 active:scale-95"
							>
								Envoyer
							</button>
						</div>
					</form>
				</section>

				<!-- Ligne de séparation visible uniquement sur mobile -->
				<hr class="border-black/10 lg:hidden" />

				<!-- Section Coordonnées -->
				<section class="lg:sticky lg:top-8">
					<h2
						class="font-title text-3xl leading-none text-black sm:text-4xl mb-6 text-center lg:text-left"
					>
						Coordonnées
					</h2>

					<div
						class="rounded-3xl bg-white p-6 shadow-soft border border-black/5"
					>
						<div
							class="space-y-6 text-base text-black/80 sm:text-lg"
						>
							<div class="flex items-start gap-4">
								<span
									class="text-2xl leading-none text-blue"
									aria-hidden="true">✉</span
								>
								<a
									href="mailto:odysigne@gmail.com"
									class="hover:text-blue transition-colors"
								>
									odysigne@gmail.com
								</a>
							</div>
							<div class="flex items-start gap-4">
								<span
									class="text-2xl leading-none text-blue"
									aria-hidden="true">☎</span
								>
								<a
									href="tel:+33684951536"
									class="hover:text-blue transition-colors"
								>
									+33 6 84 95 15 36
								</a>
							</div>
							<div class="flex items-start gap-4">
								<span
									class="text-2xl leading-none text-blue"
									aria-hidden="true">📍</span
								>
								<p>
									4 Pl. Lucien Tharradin<br />25200
									Montbéliard
								</p>
							</div>
						</div>
					</div>
				</section>
			</div>
		</main>

		<Footer logoSrc={logo.src} />
	</div>
</Layout>
