---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import logo from "../assets/img/logo.svg";
---

<Layout
	title="Odysignes - Contact"
	description="Contactez l'équipe Odysignes pour toute question ou demande."
>
	<div class="bg-white">
		<Header logoSrc={logo.src} />

		<main class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6">
			<section class="text-center">
				<h1 class="font-title text-4xl leading-none text-black sm:text-5xl">
					UNE QUESTION ?
				</h1>
				<p class="mt-2 font-title text-2xl tracking-tight text-black/95 sm:text-3xl">
					CONTACTEZ-NOUS
				</p>
			</section>

			<section class="mt-8">
				<form class="space-y-5">
					<div>
						<p class="mb-2 text-xl text-black">1. Votre nom complet</p>
						<div class="grid gap-4 sm:grid-cols-2">
							<input type="text" name="nom" placeholder="Nom" class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95" />
							<input type="text" name="prenom" placeholder="Prenom" class="h-11 w-full rounded-2xl border-0 bg-blue px-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95" />
						</div>
					</div>

					<div>
						<p class="mb-2 text-xl text-black">2. Adresse mail</p>
						<div class="flex items-center rounded-2xl bg-blue px-4 shadow-soft">
							<span class="text-2xl text-black/80" aria-hidden="true">✉</span>
							<input type="email" name="email" placeholder="Adresse mail" class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0" />
						</div>
					</div>

					<div>
						<p class="mb-2 text-xl text-black">3. Numéro de téléphone</p>
						<div class="flex items-center rounded-2xl bg-blue px-4 shadow-soft">
							<span class="text-2xl text-black/80" aria-hidden="true">☎</span>
							<input type="tel" name="telephone" placeholder="Numéro de téléphone" class="h-11 w-full border-0 bg-transparent pl-3 text-white placeholder:text-white/70 outline-none ring-0" />
						</div>
					</div>

					<div>
						<textarea name="message" rows="5" placeholder="Votre message" class="min-h-40 w-full rounded-2xl border-0 bg-blue px-4 py-4 text-white placeholder:text-white/70 shadow-soft outline-none ring-0 transition focus:opacity-95"></textarea>
					</div>

					<div class="flex justify-center">
						<button type="submit" class="rounded-2xl bg-blue px-4 py-2 font-title text-xl text-white shadow-soft transition hover:opacity-95">
							Soumettre
						</button>
					</div>
				</form>
			</section>

			<hr class="my-10 border-black/80" />

			<section>
				<h2 class="font-title text-4xl leading-none text-black sm:text-5xl">
					COORDONNÉES
				</h2>

				<div class="mt-8 rounded-[1.8rem] bg-white p-5 shadow-soft ring-1 ring-black/5">
					<div class="space-y-6 text-base text-black sm:text-lg">
						<div class="flex items-start gap-3">
							<span class="text-2xl leading-none" aria-hidden="true">✉</span>
							<p>hyoshiki@gmail.com</p>
						</div>
						<div class="flex items-start gap-3">
							<span class="text-2xl leading-none" aria-hidden="true">☎</span>
							<p>+33 6 84 95 15 36</p>
						</div>
						<div class="flex items-start gap-3">
							<span class="text-2xl leading-none" aria-hidden="true">📍</span>
							<p>4 Pl. Lucien Tharradin, 25200 Montbéliard</p>
						</div>
					</div>
				</div>

				<div class="mt-6 overflow-hidden rounded-[1.8rem] shadow-soft ring-1 ring-black/5">
					<div class="relative h-72 bg-[#eef5fb]">
						<div class="absolute inset-0 opacity-75" aria-hidden="true">
							<svg viewBox="0 0 1200 800" class="h-full w-full" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
								<rect width="1200" height="800" fill="#edf4fb" />
								<path d="M0 680H1200" stroke="#c7d5e8" stroke-width="10" opacity="0.6" />
								<path d="M160 0V800" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M360 0V800" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M720 0V800" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M960 0V800" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M0 180H1200" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M0 360H1200" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M0 540H1200" stroke="#d8e2ef" stroke-width="6" opacity="0.7" />
								<path d="M160 680C260 630 320 530 420 470C550 390 640 430 730 360C840 276 910 220 1080 120" stroke="#7f8fa8" stroke-width="18" fill="none" stroke-linecap="round" opacity="0.75" />
								<path d="M120 620C230 580 290 500 360 420C440 330 560 320 670 250C770 190 860 190 1040 70" stroke="#9fb1c8" stroke-width="12" fill="none" stroke-linecap="round" opacity="0.8" />
								<circle cx="710" cy="350" r="30" fill="#ff8f5a" opacity="0.75" />
								<circle cx="710" cy="350" r="16" fill="#ffffff" opacity="0.95" />
								<circle cx="710" cy="350" r="8" fill="#22d3ee" />
							</svg>
						</div>
						<div class="absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-xs font-semibold text-black/70 shadow-soft">
							Carte du lieu
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer logoSrc={logo.src} />
	</div>
</Layout>
