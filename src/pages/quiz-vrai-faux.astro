---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { pb } from "../lib/pocketbase";

const BASE_URL = "https://odysigne.carnicer.fr";
const FALLBACK_SVG =
    'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><text x="50" y="50" text-anchor="middle" dy=".3em">?</text></svg>';

let signes: any[] = [];

try {
    const records = await pb.collection("signes").getFullList(200);

    signes = records.map((record) => ({
        ...record,
        imageUrl: record.image
            ? `${BASE_URL}/api/files/${record.collectionId || record.collectionName || "signes"}/${record.id}/${record.image}`
            : FALLBACK_SVG,
    }));
} catch (error) {
    console.error("Erreur lors de la récupération des signes:", error);
}
---

<Layout
    title="Odysignes - Quiz Vrai ou Faux"
    description="Jeu Vrai ou Faux pour réviser la langue des signes"
>
    <div class="bg-white min-h-screen flex flex-col">
        <Header />

        <main
            id="quiz-main"
            data-signes={JSON.stringify(signes)}
            class="flex-1 mx-auto max-w-2xl w-full px-4 py-4 pt-14 md:pt-16 flex flex-col"
        >
            <!-- En-tête -->
            <div class="mb-6">
                <a
                    href="/arcade"
                    class="inline-flex items-center gap-2 text-blue hover:text-blue/80 mb-2 text-sm transition-colors"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Retour
                </a>
                <h1 class="font-title text-2xl md:text-3xl text-black">
                    Vrai ou Faux
                </h1>
                <p class="text-gray-600 text-sm mt-1">
                    Quel signe correspond à cette image ?
                </p>
            </div>

        
            <div class="flex flex-col items-center gap-6">
                <div
                    class="w-full max-w-sm bg-white rounded-3xl shadow-soft border border-black/5 p-4 flex items-center justify-center min-h-[14rem]"
                >
                    <img
                        id="signImage"
                        src=""
                        alt="Illustration du signe à deviner"
                        class="max-w-full max-h-full object-contain"
                        draggable="false"
                    />
                </div>

                <!-- Scores -->
                <div class="flex gap-4 text-center">
                    <div
                        class="bg-blue/10 rounded-xl px-4 py-2 border-2 border-blue"
                    >
                        <p
                            class="text-xs text-blue font-semibold uppercase tracking-wider"
                        >
                            Bonnes réponses
                        </p>
                        <p
                            id="score"
                            class="text-2xl font-bold text-blue"
                            aria-live="polite"
                        >
                            0
                        </p>
                    </div>
                    <div
                        class="bg-red-50 rounded-xl px-4 py-2 border-2 border-red-500"
                    >
                        <p
                            class="text-xs text-red-500 font-semibold uppercase tracking-wider"
                        >
                            Erreurs
                        </p>
                        <p
                            id="errors"
                            class="text-2xl font-bold text-red-500"
                            aria-live="polite"
                        >
                            0
                        </p>
                    </div>
                </div>

                <!-- Boutons de réponse -->
                <div class="w-full max-w-sm grid grid-cols-2 gap-4">
                    <button
                        type="button"
                        id="option1"
                        class="quiz-option h-24 rounded-2xl bg-white border-2 border-gray-200 font-semibold text-sm sm:text-base text-blue hover:bg-blue/5 hover:border-blue hover:scale-[1.02] active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100 transition-all flex flex-col items-center justify-center p-3 text-center shadow-sm"
                    >
                        <span id="option1Text"></span>
                    </button>
                    <button
                        type="button"
                        id="option2"
                        class="quiz-option h-24 rounded-2xl bg-white border-2 border-gray-200 font-semibold text-sm sm:text-base text-blue hover:bg-blue/5 hover:border-blue hover:scale-[1.02] active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed disabled:hover:scale-100 transition-all flex flex-col items-center justify-center p-3 text-center shadow-sm"
                    >
                        <span id="option2Text"></span>
                    </button>
                </div>

              
                <div
                    id="feedback"
                    class="w-full max-w-sm min-h-[3.5rem] rounded-xl flex items-center justify-center font-semibold text-base opacity-0 transition-opacity"
                    aria-live="polite"
                >
                </div>
            </div>
        </main>
    </div>
</Layout>

<script>
    import { attribuerXP } from "../lib/xp";

    document.addEventListener("DOMContentLoaded", () => {
        const mainEl = document.getElementById("quiz-main");
        if (!mainEl) return;

        const signesData = JSON.parse(mainEl.dataset.signes || "[]");
    
        const signes = signesData.filter(
            (s: any) => s.nom_signe && !s.imageUrl.startsWith("data:image/svg"),
        );

        if (signes.length < 2) {
            console.error("Pas assez de signes avec image disponibles.");
            return;
        }

        let currentSigne: any = null;
        let wrongSigne: any = null;
        let correctOption: number | null = null;
        let answered = false;
        let score = 0;
        let errors = 0;
        const playedSigns = new Set();

        const signImageEl = document.getElementById(
            "signImage",
        ) as HTMLImageElement;
        const op1El = document.getElementById("option1Text");
        const op2El = document.getElementById("option2Text");
        const optionBtns = document.querySelectorAll(".quiz-option");
        const feedbackEl = document.getElementById("feedback");
        const scoreEl = document.getElementById("score");
        const errorsEl = document.getElementById("errors");

        async function showSummary() {
            if (!mainEl) return;

            const totalQuestions = score + errors;
            const xpGagnee = await attribuerXP(score, totalQuestions);

            mainEl.innerHTML = `
        <div class="flex flex-col items-center justify-center min-h-[60vh] gap-8 text-center px-4 animate-fade-in">
          <h2 class="font-title text-4xl text-black">Bravo !</h2>
          <p class="text-xl text-gray-600">Vous avez révisé tous les signes !</p>
          <div class="bg-blue/10 px-8 py-4 rounded-2xl border border-blue/20">
            <p class="text-4xl text-blue font-bold"> + ${xpGagnee} XP</p>
          </div>
          <div class="flex gap-6 w-full max-w-sm">
            <div class="flex-1 bg-white p-6 rounded-2xl shadow-soft border border-black/5 text-center">
              <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">Bonnes réponses</p>
              <p class="text-4xl font-bold text-emerald-500">${score}</p>
            </div>
            <div class="flex-1 bg-white p-6 rounded-2xl shadow-soft border border-black/5 text-center">
              <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">Erreurs</p>
              <p class="text-4xl font-bold text-red-500">${errors}</p>
            </div>
          </div>
          <a href="/arcade" class="mt-4 px-8 py-4 bg-blue text-white rounded-2xl font-bold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all">
            Retour à l'arcade
          </a>
        </div>
      `;
        }

        function initGame() {
            if (playedSigns.size >= signes.length) {
                showSummary();
                return;
            }

          
            let randomIndex;
            do {
                randomIndex = Math.floor(Math.random() * signes.length);
            } while (playedSigns.has(signes[randomIndex].id));

            currentSigne = signes[randomIndex];
            playedSigns.add(currentSigne.id);

          
            let randomIndexWrong;
            do {
                randomIndexWrong = Math.floor(Math.random() * signes.length);
            } while (signes[randomIndexWrong].id === currentSigne.id);
            wrongSigne = signes[randomIndexWrong];

           
            if (signImageEl) {
                signImageEl.src = currentSigne.imageUrl;
                signImageEl.classList.remove("hidden");
            }

            
            const options = [
                { text: currentSigne.nom_signe, isCorrect: true },
                { text: wrongSigne.nom_signe, isCorrect: false },
            ];

            if (Math.random() < 0.5) options.reverse();

            correctOption = options.findIndex((opt) => opt.isCorrect);

            if (op1El) op1El.textContent = options[0].text;
            if (op2El) op2El.textContent = options[1].text;

            answered = false;

           
            if (feedbackEl) {
                feedbackEl.textContent = "";
                feedbackEl.className =
                    "w-full max-w-sm min-h-[3.5rem] rounded-xl flex items-center justify-center font-semibold text-base opacity-0 transition-opacity";
            }

          
            optionBtns.forEach((btn) => {
                const button = btn as HTMLButtonElement;
                button.disabled = false;
                button.classList.remove(
                    "bg-emerald-50",
                    "bg-red-50",
                    "border-emerald-500",
                    "border-red-500",
                    "text-emerald-700",
                    "text-red-700",
                );
                button.classList.add(
                    "bg-white",
                    "border-gray-200",
                    "text-blue",
                );
            });
        }

        function handleAnswer(optionIndex: number) {
            if (answered) return;
            answered = true;

            const isCorrect = optionIndex === correctOption;
            const selectedBtn = document.getElementById(
                `option${optionIndex + 1}`,
            );
            const correctBtn = document.getElementById(
                `option${(correctOption || 0) + 1}`,
            );

            if (isCorrect) {
                score++;
                if (scoreEl) scoreEl.textContent = score.toString();

                if (feedbackEl) {
                    feedbackEl.textContent = "✓ Correct !";
                    feedbackEl.className =
                        "w-full max-w-sm min-h-[3.5rem] rounded-xl flex items-center justify-center font-semibold text-base opacity-100 transition-opacity bg-emerald-100 text-emerald-700";
                }

                selectedBtn?.classList.remove(
                    "bg-white",
                    "border-gray-200",
                    "text-blue",
                );
                selectedBtn?.classList.add(
                    "bg-emerald-50",
                    "border-emerald-500",
                    "text-emerald-700",
                );
            } else {
                errors++;
                if (errorsEl) errorsEl.textContent = errors.toString();

                if (feedbackEl) {
                    feedbackEl.textContent = "✗ Incorrect !";
                    feedbackEl.className =
                        "w-full max-w-sm min-h-[3.5rem] rounded-xl flex items-center justify-center font-semibold text-base opacity-100 transition-opacity bg-red-100 text-red-700";
                }

                // Mettre en rouge le bouton cliqué
                selectedBtn?.classList.remove(
                    "bg-white",
                    "border-gray-200",
                    "text-blue",
                );
                selectedBtn?.classList.add(
                    "bg-red-50",
                    "border-red-500",
                    "text-red-700",
                );

                // Mettre en vert la bonne réponse pour montrer à l'utilisateur ce qu'il aurait dû choisir
                correctBtn?.classList.remove(
                    "bg-white",
                    "border-gray-200",
                    "text-blue",
                );
                correctBtn?.classList.add(
                    "bg-emerald-50",
                    "border-emerald-500",
                    "text-emerald-700",
                );
            }

           
            optionBtns.forEach((btn) => {
                (btn as HTMLButtonElement).disabled = true;
            });

            // Passer à la question suivante après 2 secondes
            setTimeout(initGame, 2000);
        }

        document
            .getElementById("option1")
            ?.addEventListener("click", () => handleAnswer(0));
        document
            .getElementById("option2")
            ?.addEventListener("click", () => handleAnswer(1));

        initGame();
    });
</script>
