---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { pb } from "../lib/pocketbase";

let signes: any[] = [];
try {
	signes = await pb.collection("signes").getFullList(200);
} catch (error) {
	console.error("Erreur lors de la récupération des signes:", error);
}
---

<Layout
	title="Odysignes - Swipe Vrai ou Faux"
	description="Joue en swipant à gauche ou à droite pour réviser la langue des signes"
>
	<div class="bg-white min-h-screen flex flex-col overflow-x-hidden">
		<Header />

		<main
			id="swipe-main"
			data-signes={JSON.stringify(signes)}
			class="flex-1 mx-auto max-w-2xl w-full px-4 py-4 pt-14 md:pt-16"
		>
			<!-- En-tête -->
			<div class="mb-6">
				<a
					href="/arcade"
					class="inline-flex items-center gap-2 text-blue hover:text-blue/80 mb-2 text-sm transition-colors"
				>
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M15 19l-7-7 7-7"></path>
					</svg>
					Retour
				</a>
				<h1 class="font-title text-3xl text-black">
					Swipe Vrai ou Faux
				</h1>
			</div>

			<div class="flex flex-col items-center gap-6">
				<div class="flex gap-4 text-center">
					<div
						class="bg-blue/10 rounded-xl px-4 py-2 border-2 border-blue"
					>
						<p
							class="text-xs text-blue font-semibold uppercase tracking-wider"
						>
							Bonnes réponses
						</p>
						<p
							id="score"
							class="text-2xl font-bold text-blue"
							aria-live="polite"
						>
							0
						</p>
					</div>
					<div
						class="bg-red-50 rounded-xl px-4 py-2 border-2 border-red-500"
					>
						<p
							class="text-xs text-red-500 font-semibold uppercase tracking-wider"
						>
							Erreurs
						</p>
						<p
							id="errors"
							class="text-2xl font-bold text-red-500"
							aria-live="polite"
						>
							0
						</p>
					</div>
				</div>

				<div class="w-full max-w-sm">
					<div
						class="mb-4 flex items-center justify-between text-xs font-bold uppercase tracking-widest text-black/40"
					>
						<span>← Faux</span>
						<span>Vrai →</span>
					</div>

					<div class="relative">
						<div
							id="swipeCard"
							class="relative overflow-hidden rounded-3xl border border-black/5 bg-white shadow-soft touch-none select-none transition-transform duration-200 ease-out will-change-transform cursor-grab active:cursor-grabbing"
							style="touch-action: pan-y;"
						>
							<div
								id="successFlash"
								class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-transparent text-white opacity-0 transition-all duration-200"
							>
								<span
									id="successText"
									class="rounded-full bg-black/30 px-5 py-2 text-sm font-bold tracking-wide backdrop-blur-sm"
								>
									Correct !
								</span>
							</div>

							<div
								class="absolute inset-x-0 top-0 z-10 flex justify-between px-4 pt-4 text-xs font-bold uppercase tracking-widest pointer-events-none"
							>
								<span
									id="leftLabel"
									class="rounded-full bg-red-500 px-3 py-1 text-white opacity-0 transition-opacity"
									>Faux</span
								>
								<span
									id="rightLabel"
									class="rounded-full bg-blue px-3 py-1 text-white opacity-0 transition-opacity"
									>Vrai</span
								>
							</div>

							<div
								class="relative z-10 flex min-h-[28rem] flex-col items-center justify-center gap-6 px-6 py-8"
							>
								<div
									class="rounded-full bg-blue/10 px-4 py-1 text-sm font-semibold text-blue"
								>
									Swipe la carte
								</div>
								<div
									class="w-full rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 h-56 flex items-center justify-center"
								>
									<img
										id="signImage"
										src=""
										alt="Illustration du signe"
										class="max-h-full w-auto object-contain"
									/>
								</div>
								<div class="text-center">
									<p
										class="text-xs uppercase tracking-widest text-black/40 font-semibold mb-2"
									>
										Question
									</p>
									<p
										id="questionText"
										class="font-body text-2xl leading-snug text-black font-medium"
									>
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Feedback -->
				<div
					id="feedback"
					class="w-full max-w-sm min-h-[3.5rem] rounded-2xl flex items-center justify-center font-semibold text-base opacity-0 transition-opacity"
				>
				</div>
			</div>
		</main>
	</div>
</Layout>

<script>
	import { attribuerXP } from "../lib/xp";

	document.addEventListener("DOMContentLoaded", () => {
		const mainEl = document.getElementById("swipe-main");
		if (!mainEl) return;

		const signes = JSON.parse(mainEl.dataset.signes || "[]");
		if (signes.length < 2) {
			console.error("Pas assez de signes disponibles pour jouer.");
			return;
		}

		let currentSigne: any = null;
		let correctDirection: "left" | "right" | null = null;
		let answered = false;
		let score = 0;
		let errors = 0;
		const playedSigns = new Set();

		const swipeCard = document.getElementById("swipeCard");
		const signImage = document.getElementById(
			"signImage",
		) as HTMLImageElement;
		const questionText = document.getElementById("questionText");
		const feedback = document.getElementById("feedback");
		const scoreNode = document.getElementById("score");
		const errorsNode = document.getElementById("errors");
		const leftLabel = document.getElementById("leftLabel");
		const rightLabel = document.getElementById("rightLabel");
		const successFlash = document.getElementById("successFlash");
		const successText = document.getElementById("successText");

		const SWIPE_THRESHOLD = 90;
		const RESET_DELAY = 1400;
		const BASE_URL = "https://odysigne.carnicer.fr";

		let pointerActive = false;
		let pointerId: number | null = null;
		let startX = 0,
			startY = 0,
			deltaX = 0,
			deltaY = 0;

		function getImageUrl(record: any) {
			return record.image
				? `${BASE_URL}/api/files/${record.collectionId || "signes"}/${record.id}/${record.image}`
				: "";
		}

		function setCardTransform(x: number, y: number) {
			if (!swipeCard || !leftLabel || !rightLabel) return;
			const rotation = x / 18;
			swipeCard.style.transform = `translate(${x}px, ${y * 0.12}px) rotate(${rotation}deg)`;
			leftLabel.style.opacity = x < -20 ? "1" : "0";
			rightLabel.style.opacity = x > 20 ? "1" : "0";
		}

		function resetCard() {
			if (
				!swipeCard ||
				!successFlash ||
				!successText ||
				!leftLabel ||
				!rightLabel
			)
				return;

			swipeCard.style.transition = "transform 200ms ease-out";
			swipeCard.style.transform = "translate(0px, 0px) rotate(0deg)";
			swipeCard.classList.remove(
				"border-emerald-500",
				"bg-emerald-50",
				"shadow-lg",
			);

			successFlash.className =
				"pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-transparent text-white opacity-0 transition-all duration-200";
			successText.textContent = "Correct !";

			leftLabel.style.opacity = "0";
			rightLabel.style.opacity = "0";

			setTimeout(() => {
				if (swipeCard)
					swipeCard.style.transition = "transform 200ms ease-out";
			}, 220);
		}

		async function showSummary() {
			if (!mainEl) return;

			const totalQuestions = score + errors;
			const xpGagnee = await attribuerXP(score, totalQuestions);

			mainEl.innerHTML = `
        <div class="flex flex-col items-center justify-center min-h-[70vh] gap-8 text-center px-4 animate-fade-in">
          <h2 class="font-title text-4xl text-black">Bravo !</h2>
          <p class="text-xl text-gray-600">Vous avez révisé tous les signes !</p>
          <div class="bg-blue/10 px-6 py-3 rounded-2xl border border-blue/20">
            <p class="text-3xl text-blue font-bold">+ ${xpGagnee} XP</p>
          </div>
          <div class="flex gap-6 w-full max-w-sm">
            <div class="flex-1 bg-white p-6 rounded-2xl shadow-soft border border-black/5 text-center">
              <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">Bonnes réponses</p>
              <p class="text-4xl font-bold text-emerald-500">${score}</p>
            </div>
            <div class="flex-1 bg-white p-6 rounded-2xl shadow-soft border border-black/5 text-center">
              <p class="text-xs uppercase tracking-wider text-gray-500 mb-2">Erreurs</p>
              <p class="text-4xl font-bold text-red-500">${errors}</p>
            </div>
          </div>
          <a href="/arcade" class="mt-4 px-8 py-4 bg-blue text-white rounded-2xl font-semibold shadow-lg hover:scale-105 active:scale-95 transition-all">
            Retour à l'arcade
          </a>
        </div>
      `;
		}

		function initGame() {
			if (!signImage || !questionText || !feedback) return;

			if (playedSigns.size >= signes.length) {
				showSummary();
				return;
			}

			let randomIndex;
			do {
				randomIndex = Math.floor(Math.random() * signes.length);
			} while (playedSigns.has(signes[randomIndex].id));

			currentSigne = signes[randomIndex];
			playedSigns.add(currentSigne.id);

			const shouldBeTrue = Math.random() < 0.5;
			let askedName = currentSigne.nom_signe;

			if (!shouldBeTrue) {
				let wrongIndex;
				do {
					wrongIndex = Math.floor(Math.random() * signes.length);
				} while (signes[wrongIndex].id === currentSigne.id);
				askedName = signes[wrongIndex].nom_signe;
			}

			correctDirection = shouldBeTrue ? "right" : "left";

			const imgUrl = getImageUrl(currentSigne);
			if (imgUrl) {
				signImage.src = imgUrl;
				signImage.classList.remove("hidden");
			} else {
				signImage.classList.add("hidden");
			}

			questionText.textContent = `Ce signe correspond-il à "${askedName}" ?`;
			answered = false;

			feedback.textContent = "";
			feedback.className =
				"w-full max-w-sm min-h-[3.5rem] rounded-2xl flex items-center justify-center font-semibold text-base opacity-0 transition-opacity";

			resetCard();
		}

		function finishQuestion(direction: "left" | "right") {
			if (
				answered ||
				!swipeCard ||
				!scoreNode ||
				!errorsNode ||
				!feedback ||
				!successFlash ||
				!successText ||
				!leftLabel ||
				!rightLabel
			)
				return;

			answered = true;
			const isCorrect = direction === correctDirection;

			swipeCard.style.transition =
				"transform 260ms ease-out, opacity 260ms ease-out";

			if (isCorrect) {
				score++;
				scoreNode.textContent = score.toString();

				feedback.textContent = "✓ Correct !";
				feedback.className =
					"w-full max-w-sm min-h-[3.5rem] rounded-2xl flex items-center justify-center font-semibold text-base opacity-100 transition-opacity bg-emerald-100 text-emerald-700";

				swipeCard.classList.add(
					"border-emerald-500",
					"bg-emerald-50",
					"shadow-lg",
				);
				successFlash.className =
					"pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-emerald-500/80 text-white opacity-100 transition-all duration-200";

				requestAnimationFrame(() => {
					swipeCard.style.transform =
						"translate(0px, 0px) rotate(0deg)";
				});

				setTimeout(resetCard, 360);
			} else {
				errors++;
				errorsNode.textContent = errors.toString();

				feedback.textContent = "✗ Incorrect !";
				feedback.className =
					"w-full max-w-sm min-h-[3.5rem] rounded-2xl flex items-center justify-center font-semibold text-base opacity-100 transition-opacity bg-red-100 text-red-700";

				successFlash.className =
					"pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-red-500/30 text-white opacity-100 transition-all duration-200";
				successText.textContent = "Incorrect !";
			}

			if (!isCorrect) {
				swipeCard.style.transform = `translateX(${direction === "right" ? 160 : -160}px) rotate(${direction === "right" ? 12 : -12}deg)`;
			}

			leftLabel.style.opacity = "0";
			rightLabel.style.opacity = "0";

			setTimeout(initGame, RESET_DELAY);
		}

		if (swipeCard) {
			swipeCard.addEventListener("pointerdown", (e) => {
				if (answered) return;
				pointerActive = true;
				pointerId = e.pointerId;
				startX = e.clientX;
				startY = e.clientY;
				deltaX = 0;
				deltaY = 0;
				swipeCard.setPointerCapture(pointerId);
				swipeCard.style.transition = "none";
			});

			swipeCard.addEventListener("pointermove", (e) => {
				if (!pointerActive || e.pointerId !== pointerId || answered)
					return;
				deltaX = e.clientX - startX;
				deltaY = e.clientY - startY;
				setCardTransform(deltaX, deltaY);
			});

			const endPointer = (e: PointerEvent) => {
				if (!pointerActive || e.pointerId !== pointerId) return;
				pointerActive = false;

				if (swipeCard && swipeCard.hasPointerCapture(pointerId)) {
					swipeCard.releasePointerCapture(pointerId);
				}

				if (answered) return;

				if (Math.abs(deltaX) >= SWIPE_THRESHOLD) {
					finishQuestion(deltaX > 0 ? "right" : "left");
					return;
				}

				resetCard();
			};

			swipeCard.addEventListener("pointerup", endPointer);
			swipeCard.addEventListener("pointercancel", endPointer);
		}

		// Lancement du jeu
		initGame();
	});
</script>
