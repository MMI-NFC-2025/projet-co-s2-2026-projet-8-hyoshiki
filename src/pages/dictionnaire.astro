---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { pb } from "../lib/pocketbase";

let signes: any[] = [];

try {
  // Récupération des signes
  signes = await pb.collection("signes").getFullList(200, { sort: "nom_signe" });
} catch (error) {
  console.error("Erreur lors de la récupération des signes:", error);
}

const PB_URL = "https://odysigne.carnicer.fr";

function getImageUrl(record: any): string {
  return record.image ? `${PB_URL}/api/files/signes/${record.id}/${record.image}` : "";
}
---

<Layout
  title="Odysignes - Dictionnaire LSF"
  description="Dictionnaire complet de la langue des signes"
>
  <div class="bg-white min-h-screen flex flex-col">
    <Header />

    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-8">
      
      <!-- En-tête -->
      <div class="mb-8">
        <a href="/accueil" class="inline-flex items-center gap-2 text-blue hover:text-blue/80 mb-4 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Retour
        </a>
        <h1 class="font-title text-4xl text-black">Dictionnaire LSF</h1>
        <p class="text-gray-600 mt-2">
          Retrouvez tous nos signes de la langue des signes française.
        </p>
      </div>

      <!-- Barre de recherche -->
      <div class="mb-8">
        <label for="searchInput" class="sr-only">Rechercher un signe</label>
        <input
          type="search"
          id="searchInput"
          placeholder="Rechercher un signe..."
          class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-blue focus:ring-2 focus:ring-blue/20 transition-all"
        />
      </div>

    
      <div id="signesContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {signes.map((signe) => {
          const imageUrl = getImageUrl(signe);
          return (
            <button
              type="button"
              class="signe-card group border-2 border-gray-100 bg-white rounded-xl p-4 hover:shadow-md hover:border-blue transition-all flex flex-col items-center"
              data-nom={signe.nom_signe}
              data-image={imageUrl}
              aria-label={`Voir le détail du signe : ${signe.nom_signe}`}
            >
              {imageUrl ? (
                <div class="w-full h-32 flex items-center justify-center bg-gray-50 rounded-lg mb-3 overflow-hidden">
                  <!-- Ajout de loading="lazy" et d'un effet de zoom au survol -->
                  <img
                    src={imageUrl}
                    alt={`Illustration de ${signe.nom_signe}`}
                    loading="lazy"
                    class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              ) : (
                <div class="w-full h-32 flex items-center justify-center bg-gray-50 rounded-lg mb-3 text-gray-400">
                  <span class="text-sm font-medium">Pas d'image</span>
                </div>
              )}
              <h3 class="font-semibold text-center text-sm text-black group-hover:text-blue transition-colors">
                {signe.nom_signe}
              </h3>
            </button>
          );
        })}
      </div>

      <!-- Message si aucun résultat -->
      <div id="noResults" class="hidden text-center py-12">
        <p class="text-gray-500 text-lg font-medium">Aucun signe trouvé pour cette recherche.</p>
      </div>

     
      <div
        id="signeModal"
        class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm items-center justify-center z-50 p-4 opacity-0 transition-opacity duration-300"
        aria-modal="true"
        role="dialog"
      >
        <div class="bg-white rounded-3xl max-w-md w-full p-8 relative shadow-2xl transform scale-95 transition-transform duration-300" id="modalContent">
          <button
            id="closeModal"
            class="absolute top-5 right-5 text-gray-400 hover:text-black hover:bg-gray-100 p-2 rounded-full transition-all"
            aria-label="Fermer la fenêtre"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>

          <div class="flex flex-col items-center gap-6 mt-4">
            <div class="w-full h-64 bg-gray-50 rounded-2xl flex items-center justify-center p-4">
              <img id="modalImage" src="" alt="" class="max-w-full max-h-full object-contain" />
            </div>
            <h2 id="modalTitle" class="font-title text-3xl text-black text-center"></h2>
          </div>
        </div>
      </div>

    </main>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("searchInput") as HTMLInputElement;
    const signesContainer = document.getElementById("signesContainer");
    const noResults = document.getElementById("noResults");
    const signeCards = document.querySelectorAll<HTMLElement>(".signe-card");
    
    const signeModal = document.getElementById("signeModal");
    const modalContent = document.getElementById("modalContent");
    const closeModalBtn = document.getElementById("closeModal");
    const modalImage = document.getElementById("modalImage") as HTMLImageElement;
    const modalTitle = document.getElementById("modalTitle");

    
    if (!searchInput || !signesContainer || !noResults || !signeModal) return;

    // 1. Filtrage optimisé
    searchInput.addEventListener("input", (e) => {
      const searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      signeCards.forEach((card) => {
        // On récupère le nom directement depuis le data-attribute
        const nom = (card.dataset.nom || "").toLowerCase();
        
        if (nom.includes(searchTerm)) {
          card.classList.remove("hidden");
          card.classList.add("flex");
          visibleCount++;
        } else {
          card.classList.add("hidden");
          card.classList.remove("flex");
        }
      });

      // Gestion de l'affichage du conteneur "Aucun résultat"
      if (visibleCount === 0 && searchTerm !== "") {
        noResults.classList.remove("hidden");
        signesContainer.classList.add("hidden");
        signesContainer.classList.remove("grid");
      } else {
        noResults.classList.add("hidden");
        signesContainer.classList.remove("hidden");
        signesContainer.classList.add("grid");
      }
    });

    
    const openModal = (nom: string, imageUrl: string) => {
      if (modalTitle) modalTitle.textContent = nom;
      
      if (modalImage) {
        modalImage.src = imageUrl;
        modalImage.alt = `Détail du signe : ${nom}`;
        modalImage.style.display = imageUrl ? "block" : "none";
      }

      
      signeModal.classList.remove("hidden");
      signeModal.classList.add("flex");
    
      requestAnimationFrame(() => {
        signeModal.classList.remove("opacity-0");
        modalContent?.classList.remove("scale-95");
      });
    };

    const closeModal = () => {
      signeModal.classList.add("opacity-0");
      modalContent?.classList.add("scale-95");
      
      setTimeout(() => {
        signeModal.classList.add("hidden");
        signeModal.classList.remove("flex");
      }, 300);
    };

    signeCards.forEach((card) => {
      card.addEventListener("click", () => {
        // Plus besoin de faire un .find() dans un tableau, les infos sont sur la carte !
        openModal(card.dataset.nom || "", card.dataset.image || "");
      });
    });

    closeModalBtn?.addEventListener("click", closeModal);
    
    signeModal.addEventListener("click", (e) => {
      if (e.target === signeModal) closeModal();
    });
    
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !signeModal.classList.contains("hidden")) {
        closeModal();
      }
    });
  });
</script>