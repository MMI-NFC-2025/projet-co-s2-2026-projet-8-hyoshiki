---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import logoSwipe from "../assets/img/Logo_swipe_jeux.svg";
import logoVraiFaux from "../assets/img/Logo_vrai_faux_jeux.svg";
import logoPuzzle from "../assets/img/Logo_puzzle_jeux.svg";
import logoMemory from "../assets/img/Logo_memory_jeux.svg";

const games = [
    {
        href: "/jeu_swipe",
        icon: logoSwipe.src,
        label: "Swipez dans la bonne direction",
        iconClass: "max-h-20 w-auto",
    },
    {
        href: "/quiz-vrai-faux",
        icon: logoVraiFaux.src,
        label: "Testez vos connaissances",
        iconClass: "max-h-20 w-auto",
    },
    {
        href: "/puzzle",
        icon: logoPuzzle.src,
        label: "Reconstituez les dialogues",
        iconClass: "max-h-24 w-auto scale-125",
    },
    {
        href: "/memory",
        icon: logoMemory.src,
        label: "Associez image et signes",
        iconClass: "max-h-24 w-auto scale-125",
    },
];
---

<Layout
    title="Odysignes - Arcade et défis"
    description="Jeux et défis pour réviser la langue des signes"
>
    <div class="bg-white min-h-screen flex flex-col">
        <Header />

        <main
            class="flex-1 mx-auto w-full max-w-md px-6 py-12 flex flex-col items-center"
        >
            <div class="text-center mb-10">
                <h1
                    class="font-title text-4xl text-blue uppercase tracking-wide mb-2"
                >
                    Arcade & Défis
                </h1>
                <p class="text-black font-body text-base">
                    Donnez le meilleur de vous-même !
                </p>
            </div>

            <div class="w-full flex flex-col gap-6">
                {
                    games.map((game) => (
                        <a
                            href={game.href}
                            class="group flex flex-col bg-blue rounded-3xl shadow-soft hover:shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-95 overflow-hidden h-44"
                        >
                            <div class="flex-1 flex items-center justify-center p-6 overflow-hidden">
                                <img
                                    src={game.icon}
                                    alt={`Icône du jeu : ${game.label}`}
                                    class={`object-contain transition-transform duration-300 group-hover:scale-110 ${game.iconClass}`}
                                />
                            </div>

                            <div class="border-t border-white/30 h-12 shrink-0 flex items-center justify-center px-4 bg-blue/95 relative z-10">
                                <span class="text-white font-title text-sm uppercase tracking-wider text-center leading-tight">
                                    {game.label}
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </main>

        <Footer />
    </div>
</Layout>
