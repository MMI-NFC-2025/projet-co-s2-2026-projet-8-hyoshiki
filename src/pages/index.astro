---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Header from "../components/Header_promo.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ModeCard from "../components/ModeCard.astro";
import StatItem from "../components/StatItem.astro";
import AvatarCard from "../components/AvatarCard.astro";
import FooterPromo from "../components/Footer_promo.astro";

import logo from "../assets/img/logo.svg";
import hyo from "../assets/img/Hyo.svg";
import shiki from "../assets/img/Shiki.svg";
import shapeHero from "../assets/img/forme_bleu.svg";
import shapeTop from "../assets/img/forme_bleu2.svg";
import shapeMid from "../assets/img/forme_bleu3.svg";

import iconVisual from "../assets/img/logo.svg";
import iconProgress from "../assets/img/logo1.svg";
import iconPlay from "../assets/img/logo2.svg";
import iconStories from "../assets/img/logo4.svg";
import iconModeLessons from "../assets/img/logo_7.svg";
import iconRewards from "../assets/img/logo5.svg";
import iconCommunity from "../assets/img/logo6.svg";

import avatarKonstance from "../assets/img/konstance_avatar.svg";
import avatarMatthis from "../assets/img/matthis_avatar.svg";
import avatarMatias from "../assets/img/matias_avatar.svg";

const features = [
	{
		icon: iconVisual,
		title: "Apprentissage Visuel",
		description:
			"Mémorisez facilement grâce à des illustrations et animations captivantes",
	},
	{
		icon: iconProgress,
		title: "Méthode Progressive",
		description:
			"Avancez à votre rythme avec un système de déblocage adaptatif",
	},
	{
		icon: iconPlay,
		title: "Ludique & Engageant",
		description:
			"5 mini-jeux différents pour ne jamais s'ennuyer en apprenant",
	},
	{
		icon: iconStories,
		title: "Histoires Immersives",
		description: "Apprenez en suivant des aventures narratives captivantes",
	},
	{
		icon: iconRewards,
		title: "Système de Récompenses",
		description:
			"Gagnez des XP, débloquez des succès et suivez votre progression",
	},
	{
		icon: iconCommunity,
		title: "Communauté Active",
		description:
			"Rejoignez des milliers d'apprenants passionnés par la LSF",
	},
];

const modes = [
	{
		icon: iconStories,
		title: "Aventures illustrées",
		iconClass: "h-14 w-14",
		description:
			"Suivez des histoires captivantes avec Hyo et Shiki. Apprenez naturellement en découvrant la LSF à travers des scénarios du quotidien.",
		bullets: [
			"12 chapitres narratifs",
			"Dialogues interactifs",
			"Illustrations immersives",
		],
	},
	{
		icon: iconModeLessons,
		title: "Leçons thématiques",
		description:
			"Apprenez par catégories : chambre, cuisine, famille... Chaque leçon combine découverte et exercices pratiques.",
		bullets: [
			"12 thématiques variées",
			"Apprentissage structuré",
			"Quiz de validation",
		],
	},
	{
		icon: iconPlay,
		title: "Arcade et défis",
		iconClass: "h-14 w-14",
		description:
			"5 mini-jeux addictifs pour réviser en s'amusant. Swipe, Mémory, Puzzle, Quiz et Contre-la-montre !",
		bullets: [
			"5 types de mini-jeux",
			"Plusieurs niveaux de difficulté",
			"Défis quotidiens",
		],
	},
	{
		icon: iconRewards,
		title: "Progression et succès",
		iconClass: "h-14 w-14",
		description:
			"Suivez votre évolution, débloquez des succès et maintenez votre série d'apprentissage quotidien.",
		bullets: [
			"Système de niveaux et XP",
			"Badges et récompenses",
			"Statistiques détaillées",
		],
	},
];

const heroStats = [
	{ value: "10K+", label: "Apprenants actifs" },
	{ value: "500+", label: "Mots LSF" },
	{ value: "4.9/5", label: "Note moyenne" },
];

const megaStats = [
	{ value: "500+", label: "Mots LSF" },
	{ value: "12", label: "Chapitres narratifs" },
	{ value: "5", label: "Mini-jeux uniques" },
	{ value: "10K+", label: "Utilisateurs actifs" },
];

const team = [
	{
		avatar: avatarKonstance,
		name: "KONSTANCE",
		role: "Communication",
		description:
			"Passionnée par le partage et l'image, Konstance fait rayonner l'univers de Hyoshiki sur tous nos réseaux. Elle crée le lien entre notre communauté et l'apprentissage de la LSF à travers des contenus créatifs et engageants.",
	},
	{
		avatar: avatarMatthis,
		name: "MATTHIS",
		role: "Développement technique", // Correction orthographique
		description:
			"Garant de la fluidité et de la technique, Matthis transforme nos idées en une plateforme interactive et sécurisée. Il veille à ce que chaque ligne de code serve l'accessibilité et le plaisir d'apprendre pour tous nos utilisateurs.",
	},
	{
		avatar: avatarMatias,
		name: "MATIAS",
		role: "Design",
		description:
			"Matias est le designer de l'expérience utilisateur. Il conçoit une interface colorée et des illustrations pédagogiques qui rendent la langue des signes instinctive et ludique.",
	},
];
---

<Layout
	title="Odysignes - Apprendre la LSF"
	description="Apprenez la langue des signes en vous amusant."
>
	<div class="bg-[#e9f9ff]">
		<Header logoSrc={logo.src} />

		<section class="relative overflow-hidden">
			<img
				src={shapeHero.src}
				alt=""
				aria-hidden="true"
				class="absolute right-0 top-10 hidden w-[32rem] md:block"
			/>

			<div
				class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-16 md:grid-cols-[1.1fr_1fr] relative z-10"
			>
				<div class="space-y-6">
					<h1
						class="font-title text-4xl leading-tight text-black md:text-5xl lg:text-6xl"
					>
						Apprenez la <span class="text-blue"
							>Langue des signes</span
						> en vous amusant
					</h1>
					<p
						class="max-w-xl text-base leading-relaxed text-black/80 font-body"
					>
						Odysignes révolutionne l'apprentissage de la LSF avec
						des aventures narratives, des leçons thématiques et des
						mini-jeux captivants. Rejoignez Hyo et Shiki dans cette
						aventure linguistique unique !
					</p>
					<Button
						href="#cta"
						size="lg"
						class="rounded-2xl font-semibold shadow-lg shadow-blue/30"
					>
						Commencer l'aventure
					</Button>

					<div class="grid max-w-md grid-cols-3 gap-6 pt-6 font-body">
						{
							heroStats.map((stat) => (
								<StatItem
									value={stat.value}
									label={stat.label}
								/>
							))
						}
					</div>
				</div>

				<div class="relative flex items-center justify-center">
					<div class="relative flex items-end gap-6">
						<img
							src={hyo.src}
							alt="Personnage Hyo"
							class="h-80 md:h-96 w-auto drop-shadow-xl"
						/>
						<img
							src={shiki.src}
							alt="Personnage Shiki"
							class="h-72 md:h-80 w-auto drop-shadow-xl"
						/>
					</div>
				</div>
			</div>
		</section>
	</div>

	<section id="fonctionnalites" class="relative overflow-hidden py-20">
		<img
			src={shapeTop.src}
			alt=""
			aria-hidden="true"
			class="absolute left-0 top-0 hidden w-[36rem] z-0 md:block opacity-50"
			loading="lazy"
		/>

		<div class="relative z-10 mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				<h2 class="font-title text-4xl md:text-5xl text-black">
					Pourquoi choisir <span class="text-blue">Odysignes</span> ?
				</h2>
				<p class="mt-4 text-base text-black/70 max-w-2xl mx-auto">
					Une approche innovante qui combine narration, gamification
					et apprentissage adaptatif
				</p>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					features.map((feature) => (
						<FeatureCard
							icon={feature.icon}
							title={feature.title}
							description={feature.description}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section id="apprentissage" class="bg-[#e9f9ff] py-20">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				<h2 class="font-title text-4xl md:text-5xl text-black">
					4 Modes d'apprentissage
				</h2>
				<p class="mt-4 text-base text-black/70 max-w-2xl mx-auto">
					Choisissez le mode qui correspond à votre style
					d'apprentissage
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2">
				{
					modes.map((mode) => (
						<ModeCard
							icon={mode.icon}
							title={mode.title}
							description={mode.description}
							bullets={mode.bullets}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="relative overflow-hidden py-16 pb-32 md:pb-48 bg-blue z-0">
		<img
			src={shapeMid.src}
			alt=""
			aria-hidden="true"
			loading="lazy"
			class="absolute left-0 -top-32 w-full h-auto pointer-events-none select-none -z-10 min-w-[32rem] max-w-full opacity-30"
		/>

		<div
			class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 text-white md:grid-cols-4 relative z-10"
		>
			{
				megaStats.map((stat) => (
					<div class="text-center">
						<p class="text-5xl font-bold md:text-6xl drop-shadow-md">
							{stat.value}
						</p>
						<p class="text-sm md:text-base uppercase tracking-wider text-white/90 font-semibold mt-3 font-fredoka">
							{stat.label}
						</p>
					</div>
				))
			}
		</div>

		<div
			class="absolute bottom-0 left-0 w-full overflow-hidden pointer-events-none h-24 md:h-40"
		>
			<svg
				class="w-full h-full text-white"
				viewBox="0 0 1200 160"
				preserveAspectRatio="none"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M0,0 C175,125 375,125 600,80 C825,35 1025,130 1200,70 L1200,160 L0,160 Z"
				></path>
			</svg>
		</div>
	</section>

	<section class="bg-white py-20">
		<div class="mx-auto max-w-4xl px-6 text-center">
			<h2 class="font-title text-4xl text-black md:text-5xl mb-8">
				L'apprentissage de la LSF, <span class="text-blue"
					>réinventé</span
				>
			</h2>
			<div class="space-y-6 text-lg leading-relaxed text-black/75">
				<p>
					Odysignes est née d'une conviction : apprendre la langue des
					signes française doit être accessible, ludique et motivant.
					Inspiré par les meilleures applications d'apprentissage
					linguistique, nous avons créé une expérience unique qui
					s'adapte à votre style d'apprentissage visuel.
				</p>
				<p>
					Que vous soyez débutant complet ou que vous souhaitiez
					perfectionner vos connaissances, Hyoshiki vous accompagne à
					chaque étape avec Hyo et Shiki, vos compagnons d'aventure
					virtuels.
				</p>
			</div>
		</div>
	</section>

	<section id="cta" class="relative overflow-hidden bg-blue py-24 md:py-32">
		<div
			class="absolute top-0 left-0 w-full overflow-hidden pointer-events-none h-24 md:h-32 -translate-y-6 rotate-180"
		>
			<svg
				class="w-full h-full text-white"
				viewBox="0 0 1200 160"
				preserveAspectRatio="none"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M0,0 C175,125 375,125 600,80 C825,35 1025,130 1200,70 L1200,160 L0,160 Z"
				></path>
			</svg>
		</div>

		<div
			class="mx-auto max-w-3xl px-6 text-center text-white relative z-10 flex flex-col items-center"
		>
			<h2 class="font-title text-4xl md:text-5xl mb-6 drop-shadow-md">
				Prêt à commencer votre aventure LSF ?
			</h2>
			<p class="text-lg md:text-xl text-white/90 mb-10">
				Rejoignez des milliers d'apprenants dès aujourd'hui.
			</p>

			<a
				href="/register"
				class="inline-flex items-center justify-center rounded-2xl bg-white text-blue px-8 py-4 font-title text-xl shadow-lg transition-all duration-300 hover:scale-105 hover:bg-gray-50 active:scale-95"
			>
				Inscrivez-vous gratuitement
			</a>
		</div>

		<div
			class="absolute bottom-0 left-0 w-full overflow-hidden pointer-events-none h-24 md:h-32 translate-y-6"
		>
			<svg
				class="w-full h-full text-white"
				viewBox="0 0 1200 160"
				preserveAspectRatio="none"
				fill="currentColor"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					d="M0,0 C175,125 375,125 600,80 C825,35 1025,130 1200,70 L1200,160 L0,160 Z"
				></path>
			</svg>
		</div>
	</section>

	<section class="bg-white py-20">
		<div class="mx-auto max-w-6xl px-6">
			<div class="text-center mb-12">
				<h2 class="font-title text-4xl text-black">
					L'équipe derrière <span class="text-blue">Odysignes</span>
				</h2>
			</div>
			<div class="grid gap-8 md:grid-cols-3">
				{
					team.map((member) => (
						<AvatarCard
							avatar={member.avatar}
							name={member.name}
							role={member.role}
							description={member.description}
						/>
					))
				}
			</div>
		</div>
	</section>

	<FooterPromo logoSrc={logo.src} />
</Layout>
