---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import imageCafe from "../assets/img/café.avif";
import imageParc from "../assets/img/parc.avif";
---

<Layout>
    <main class="flex flex-col items-center w-full bg-white min-h-screen">
        <div class="w-full max-w-md flex flex-col relative bg-white border-x border-slate-100 min-h-screen">
            <div class="shrink-0 mb-6">
                <Header />
            </div>
            
            <div class="flex-1 px-10 py-6 space-y-6 overflow-y-auto">
                <h1 class="text-2xl font-bold text-slate-800">Mes aventures</h1>
                
                <a href="/aventure/1" class="block group">
                    <div class="bg-white rounded-3xl shadow-md overflow-hidden border border-slate-100 transition-transform group-hover:scale-[1.02]">
                        <img src={imageCafe.src} class="w-full h-36 object-cover" alt="Chapitre 1" />
                        <div class="p-4"><h2 class="text-lg font-bold">Chapitre 1 : La rencontre</h2></div>
                    </div>
                </a>

                <a href="/aventure/2" class="block group">
                    <div class="bg-white rounded-3xl shadow-md overflow-hidden border border-slate-100 transition-transform group-hover:scale-[1.02]">
                        <img src={imageParc.src} class="w-full h-32 object-cover" alt="Chapitre 2" />
                        <div class="p-4"><h2 class="text-lg font-bold">Chapitre 2 : Le parc</h2></div>
                    </div>
                </a>
            </div>

            <div class="shrink-0 mt-6">
                <Footer />
            </div>
        </div>
    </main>
</Layout>