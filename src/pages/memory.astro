---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { pb } from "../lib/pocketbase";

// Récupérer les signes depuis PocketBase
let signes: any[] = [];
try {
  signes = await pb.collection("signes").getFullList(50);
} catch (error) {
  console.error("Erreur lors de la récupération des signes:", error);
}

// Mots-clés pour identifier les signes d'émotions
const emotionKeywords = [
  "peur", "joyeux", "espoir", "colère", 
  "bonjour", "au revoir", "dormir", "à bientôt",
];

const emotionSigns = signes.filter((signe) => {
  const nomLower = signe.nom_signe?.toLowerCase() || "";
  return emotionKeywords.some((keyword) => nomLower.includes(keyword));
});


const selectedSignes = emotionSigns.slice(0, 8);
const pairs: any[] = [];

selectedSignes.forEach((signe) => {
  pairs.push({ ...signe, type: "image" });
  pairs.push({ ...signe, type: "text" });
});

pairs.sort(() => Math.random() - 0.5);


const BASE_URL = "https://odysigne.carnicer.fr";
function getImageUrl(record: any): string {
  return record.image 
    ? `${BASE_URL}/api/files/${record.collectionId || record.collectionName || "signes"}/${record.id}/${record.image}` 
    : 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><text x="50" y="50" text-anchor="middle" dy=".3em">?</text></svg>';
}
---

<Layout
  title="Odysignes - Jeu Mémory"
  description="Jeu Mémory - Trouvez les paires de signes"
>
  <div class="bg-white min-h-screen flex flex-col">
    <Header />
    <main id="memory-main" class="flex-1 mx-auto mt-6 max-w-3xl w-full px-4 py-8 pt-12 md:pt-16">
      
      <!-- En-tête -->
      <div class="mb-8">
        <a href="/arcade" class="inline-flex items-center gap-2 text-blue hover:text-blue/80 mb-2 text-sm transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Retour
        </a>
        <h1 class="font-title text-3xl text-black">Mémory</h1>
        <p class="text-gray-600 mt-2">Trouvez les paires de signes !</p>
      </div>

    
      <div class="mb-8 flex justify-center gap-6 text-center">
        <div class="bg-blue/10 rounded-xl px-6 py-2 border-2 border-blue">
          <p class="text-xs text-blue font-semibold uppercase tracking-wider">Paires trouvées</p>
          <p class="text-2xl font-bold text-blue" aria-live="polite"><span id="found">0</span>/8</p>
        </div>
        <div class="bg-orange-50 rounded-xl px-6 py-2 border-2 border-orange-400">
          <p class="text-xs text-orange-500 font-semibold uppercase tracking-wider">Temps restant</p>
          <p class="text-2xl font-bold text-orange-500" aria-live="polite"><span id="timer">120</span>s</p>
        </div>
      </div>

    
    
      <div id="game-board" class="grid grid-cols-4 gap-3 sm:gap-4 mb-8">
        {pairs.map((signe, index) => (
          <button
            type="button"
            class="memory-card relative bg-cyan-300 rounded-xl h-24 sm:h-32 md:h-40 cursor-pointer overflow-hidden transition-all duration-200 hover:scale-[1.02] active:scale-95 hover:shadow-md"
            data-index={index}
            data-id={signe.id}
            aria-label="Carte de mémory"
          >
    
            <div class="sign-back absolute inset-0 flex items-center justify-center bg-cyan-400 text-4xl md:text-5xl font-bold text-white transition-opacity">
              ?
            </div>
            
    
            <div class="sign-front absolute inset-0 hidden items-center justify-center bg-white p-2 transition-opacity">
              {signe.type === "image" ? (
                <img
                  src={getImageUrl(signe)}
                  class="max-w-full max-h-full object-contain"
                  alt={`Illustration de ${signe.nom_signe}`}
                  loading="lazy"
                />
              ) : (
                <span class="text-sm sm:text-lg md:text-xl font-semibold text-black text-center leading-tight">
                  {signe.nom_signe}
                </span>
              )}
            </div>
          </button>
        ))}
      </div>

    
      <div class="text-center">
        <button
          id="reset-btn"
          class="bg-blue text-white px-8 py-3 rounded-2xl font-bold uppercase tracking-wider shadow-md hover:scale-105 active:scale-95 transition-all"
        >
          Recommencer
        </button>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { attribuerXP } from "../lib/xp.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const mainEl = document.getElementById("memory-main");
    const cardsContainer = document.getElementById("game-board");
    const foundCount = document.getElementById("found");
    const timerDisplay = document.getElementById("timer");
    const resetBtn = document.getElementById("reset-btn");

    if (!mainEl || !cardsContainer || !foundCount || !timerDisplay) return;

    let flipped: HTMLElement[] = [];
    let matched: string[] = [];
    let timeLeft = 120;
    let timerInterval: number | null = null;
    let gameOver = false;
    let isChecking = false;
    const TOTAL_PAIRS = 8;

    
    function shuffleCards() {
      const cards = Array.from(document.querySelectorAll(".memory-card")) as HTMLElement[];
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((card, index) => {
        card.setAttribute("data-index", index.toString());
        cardsContainer?.appendChild(card);
      });
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = window.setInterval(() => {
        timeLeft--;
        timerDisplay!.textContent = timeLeft.toString();

        if (timeLeft <= 0) {
          endGame(false);
        }
      }, 1000);
    }

    function flipCard(card: HTMLElement) {
      if (gameOver || isChecking || card.classList.contains("matched") || flipped.includes(card)) return;

      
      const signBack = card.querySelector(".sign-back");
      const signFront = card.querySelector(".sign-front");
      
      signBack?.classList.add("hidden");
      signFront?.classList.remove("hidden");
      signFront?.classList.add("flex");
      
      card.classList.add("flipped");
      flipped.push(card);

      if (flipped.length === 2) {
        isChecking = true;
        checkMatch();
      }
    }

    function checkMatch() {
      const card1 = flipped[0];
      const card2 = flipped[1];
      const id1 = card1.getAttribute("data-id");
      const id2 = card2.getAttribute("data-id");

      if (id1 === id2) {
        // Bonne paire
        matched.push(id1!);
        card1.classList.add("matched", "cursor-not-allowed", "opacity-80");
        card2.classList.add("matched", "cursor-not-allowed", "opacity-80");
        
        foundCount!.textContent = matched.length.toString();
        isChecking = false;
        flipped = [];

        if (matched.length === TOTAL_PAIRS) {
          endGame(true);
        }
      } else {
        // Mauvaise paire
        setTimeout(() => {
          [card1, card2].forEach(card => {
            card.classList.remove("flipped");
            const back = card.querySelector(".sign-back");
            const front = card.querySelector(".sign-front");
            back?.classList.remove("hidden");
            front?.classList.add("hidden");
            front?.classList.remove("flex");
          });
          flipped = [];
          isChecking = false;
        }, 1000);
      }
    }

    async function endGame(won: boolean) {
      if (!mainEl) return;
      
      gameOver = true;
      if (timerInterval) clearInterval(timerInterval);

      if (won) {
        const xpGagnee = await attribuerXP(matched.length, TOTAL_PAIRS);
        
        mainEl.innerHTML = `
          <div class="flex flex-col items-center justify-center min-h-[60vh] gap-8 text-center px-4 animate-fade-in">
            <h2 class="font-title text-4xl text-black">Félicitations !</h2>
            <p class="text-xl text-gray-600">Vous avez trouvé toutes les paires !</p>
            <div class="bg-blue/10 px-8 py-4 rounded-2xl border border-blue/20">
              <p class="text-4xl text-blue font-bold"> + ${xpGagnee} XP</p>
            </div>
            <a href="/arcade" class="mt-4 px-8 py-4 bg-blue text-white rounded-2xl font-bold uppercase tracking-wider shadow-lg hover:scale-105 active:scale-95 transition-all">
              Retour à l'arcade
            </a>
          </div>
        `;
      } else {
        // Défaite au temps
        alert("Temps écoulé ! Essayez encore !");
        resetGame();
      }
    }

    function resetGame() {
      flipped = [];
      matched = [];
      timeLeft = 120;
      gameOver = false;
      isChecking = false;
      
      foundCount!.textContent = "0";
      timerDisplay!.textContent = "120";

      const cards = document.querySelectorAll(".memory-card") as NodeListOf<HTMLElement>;
      cards.forEach((card) => {
        card.classList.remove("flipped", "matched", "cursor-not-allowed", "opacity-80");
        const back = card.querySelector(".sign-back");
        const front = card.querySelector(".sign-front");
        back?.classList.remove("hidden");
        front?.classList.add("hidden");
        front?.classList.remove("flex");
      });

      shuffleCards();
      startTimer();
    }

    const cards = document.querySelectorAll(".memory-card") as NodeListOf<HTMLElement>;
    cards.forEach((card) => {
      card.addEventListener("click", () => flipCard(card));
    });

    resetBtn?.addEventListener("click", resetGame);
    startTimer();
  });
</script>