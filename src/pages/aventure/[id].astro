---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { pb } from "../../lib/pocketbase";

const { id } = Astro.params;
const baseApiUrl = "https://odysigne.carnicer.fr";

let signes = await pb.collection("signes").getFullList({ sort: "@random" });
const signeBonjour = signes.find(s => s.nom_signe?.toLowerCase() === "bonjour");
const signeAutre = signes.find(s => s.nom_signe?.toLowerCase() !== "bonjour");

interface AventureRecord {
    id: string;
    nom_etape: string;
    context_histoire: string;
    Fond_Aventure: string;
    collectionName: string;
    ordre: number;
}

let aventures: AventureRecord[] = [];

try {
    const allChapitres = await pb.collection("chapitres").getFullList<AventureRecord>({ sort: "ordre" });
    aventures = allChapitres
        .filter((a) => a.nom_etape?.toLowerCase().includes(`chapitre ${id}`))
        .sort((a, b) => (a.ordre || 0) - (b.ordre || 0));
} catch (error) {
    console.error("Erreur PB:", error);
}
---

<Layout>
    <main class="bg-white flex flex-col items-center w-full min-h-screen">
        <div class="w-full max-w-md flex flex-col relative bg-white border-x border-slate-100 min-h-screen">
            <div class="flex-1 w-full flex flex-col" id="dialogues-wrapper">
                {aventures.length > 0 ? (
                    aventures.map((aventure, index) => (
                        <div class="aventure-dialogue transition-all duration-500 hidden flex-col flex-1 relative" data-index={index}>
                            {aventure.Fond_Aventure && (
                                <div class="w-full h-[50vh] overflow-hidden bg-white relative">
                                    <img 
                                        src={`${baseApiUrl}/api/files/${aventure.collectionName}/${aventure.id}/${aventure.Fond_Aventure}`} 
                                        class="w-full h-full object-cover object-top" 
                                        alt="Fond aventure" 
                                    />
                                    {index === 12 && (
                                        <div class="absolute top-10 left-4 w-1/2 z-10">
                                            <div class="bg-white p-4 rounded-3xl shadow-lg border-2 border-cyan-400">
                                                <p class="font-bold text-sm text-slate-800 leading-snug">"{aventure.context_histoire}"</p>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            )}

                            {index === 12 ? (
                                <div class="p-6 grid grid-cols-2 gap-4">
                                    <button id="btn-correct" class="border-4 border-slate-200 rounded-3xl p-2 overflow-hidden shadow-sm transition-all">
                                        <img src={baseApiUrl + "/api/files/signes/" + signeBonjour?.id + "/" + signeBonjour?.image} class="w-full h-32 object-contain" />
                                    </button>
                                    <button id="btn-wrong" class="border-4 border-slate-200 rounded-3xl p-2 overflow-hidden shadow-sm transition-all">
                                        <img src={baseApiUrl + "/api/files/signes/" + signeAutre?.id + "/" + signeAutre?.image} class="w-full h-32 object-contain" />
                                    </button>
                                </div>
                            ) : (
                                <div class="p-6 flex-1 flex flex-col justify-center">
                                    <div class="bg-cyan-400 p-6 rounded-3xl text-white shadow-lg">
                                        <p class="font-bold text-lg leading-relaxed">"{aventure.context_histoire}"</p>
                                    </div>
                                </div>
                            )}
                        </div>
                    ))
                ) : (
                    <p class="p-10 text-center text-slate-500">Aucun dialogue trouvé.</p>
                )}
            </div>

            <div class="p-6 mt-auto flex justify-between items-center border-t border-slate-100">
                <button id="prev-btn" class="px-6 py-3 bg-slate-100 rounded-2xl font-bold text-slate-600 disabled:opacity-30">Précédent</button>
                <span id="completion-text" class="font-bold text-slate-400">1 / {aventures.length}</span>
                <button id="next-btn" class="px-6 py-3 bg-cyan-400 text-white rounded-2xl font-bold disabled:opacity-30">Suivant</button>
            </div>
        </div>
    </main>
</Layout>

<script>
    let currentIndex = 0;
    const dialogues = document.querySelectorAll(".aventure-dialogue");
    const total = dialogues.length;

    function showDialogue(index: number) {
        dialogues.forEach((d, i) => {
            const el = d as HTMLElement;
            el.style.display = (i === index) ? "flex" : "none";
        });
        
        currentIndex = index;
        const compText = document.getElementById("completion-text");
        if(compText) compText.textContent = `${currentIndex + 1} / ${total}`;
        
        const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;
        const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
        
        if(nextBtn) nextBtn.style.visibility = (index === 12 || index === 13) ? "hidden" : "visible";
        if(prevBtn) prevBtn.disabled = (index === 0);
    }

    // Gestion propre des clics avec delegation
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const correctBtn = document.getElementById("btn-correct");
        const wrongBtn = document.getElementById("btn-wrong");

        if (target.closest("#btn-correct")) {
            correctBtn?.classList.replace("border-slate-200", "border-green-500");
            setTimeout(() => showDialogue(14), 800);
        } else if (target.closest("#btn-wrong")) {
            wrongBtn?.classList.replace("border-slate-200", "border-red-500");
            correctBtn?.classList.replace("border-slate-200", "border-green-500");
            setTimeout(() => showDialogue(13), 800);
        }
    });

    document.getElementById("prev-btn")?.addEventListener("click", () => {
        if (currentIndex > 0) showDialogue(--currentIndex);
    });
    
    document.getElementById("next-btn")?.addEventListener("click", () => {
        if (currentIndex === total - 1) {
            window.location.href = "/aventure";
        } else if (currentIndex < total - 1) {
            showDialogue(++currentIndex);
        }
    });

    if (total > 0) showDialogue(0);
</script>