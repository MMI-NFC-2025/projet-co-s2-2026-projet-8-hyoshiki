---
import Layout from "../layouts/Layout.astro";
import cameraIcon from "../assets/img/Camera_mon_compte.svg?url";
---

<Layout title="Inscription - Odysignes">
    <div
        class="min-h-screen bg-blue flex flex-col items-center justify-center p-6 relative"
    >
        <a
            href="/"
            class="absolute top-8 left-8 text-white hover:scale-110 transition-transform duration-200"
            aria-label="Retour à l'accueil"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
        </a>

        <div class="w-full max-w-sm mt-8">
            <div class="text-left mb-8">
                <h1
                    class="text-white text-4xl font-bold font-title tracking-wide"
                >
                    Créez un compte
                </h1>
                <p class="text-white/90 font-body mt-2">
                    Déjà un compte ?
                    <a
                        href="/login"
                        class="font-semibold underline hover:text-white transition-colors"
                    >
                        Se connecter
                    </a>
                </p>
            </div>

            <form id="register-form" class="space-y-5">
                <div class="flex flex-col items-center">
                    <span class="mb-3 block text-sm font-semibold text-white"
                        >Photo de profil (Optionnel)</span
                    >
                    <label
                        for="avatar"
                        class="group relative flex cursor-pointer items-center justify-center focus-within:ring-2 focus-within:ring-white focus-within:ring-offset-2 focus-within:ring-offset-blue rounded-full transition-all hover:scale-105"
                        tabindex="0"
                    >
                        <div
                            class="relative flex h-28 w-28 items-center justify-center rounded-full bg-white shadow-lg ring-4 ring-white/30 overflow-hidden"
                        >
                            <img
                                id="avatar-preview"
                                alt="Aperçu de la photo de profil"
                                class="hidden h-full w-full object-cover"
                            />

                            <div
                                id="avatar-placeholder"
                                class="flex h-full w-full items-center justify-center text-blue"
                            >
                                <img
                                    src={cameraIcon}
                                    alt="Caméra"
                                    aria-hidden="true"
                                    class="h-11 w-11 opacity-80 group-hover:opacity-100 transition-opacity"
                                />
                            </div>
                        </div>

                        <div
                            class="absolute -bottom-1 -right-1 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white shadow-md ring-2 ring-blue"
                        >
                            <img
                                src={cameraIcon}
                                alt="Caméra "
                                aria-hidden="true"
                                class="h-4 w-4"
                            />
                        </div>

                        <input
                            id="avatar"
                            name="avatar"
                            type="file"
                            accept="image/png, image/jpeg, image/webp"
                            class="sr-only"
                        />
                    </label>
                    <p class="mt-3 text-xs text-white/80">
                        PNG, JPG ou WEBP (Max 5 Mo)
                    </p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label for="email" class="sr-only">Adresse mail</label>
                        <input
                            type="email"
                            id="email"
                            placeholder="Adresse mail"
                            required
                            class="w-full px-4 py-3.5 bg-white/10 border-2 border-white/80 rounded-2xl text-white placeholder-white/80 focus:outline-none focus:border-white focus:ring-2 focus:ring-white/30 transition-all"
                        />
                    </div>

                    <div>
                        <label for="pseudo" class="sr-only">Pseudo</label>
                        <input
                            type="text"
                            id="pseudo"
                            placeholder="Pseudo"
                            required
                            minlength="2"
                            class="w-full px-4 py-3.5 bg-white/10 border-2 border-white/80 rounded-2xl text-white placeholder-white/80 focus:outline-none focus:border-white focus:ring-2 focus:ring-white/30 transition-all"
                        />
                    </div>

                    <div>
                        <label for="password" class="sr-only"
                            >Mot de passe</label
                        >
                        <input
                            type="password"
                            id="password"
                            placeholder="Mot de passe (8 caractères min.)"
                            required
                            minlength="8"
                            class="w-full px-4 py-3.5 bg-white/10 border-2 border-white/80 rounded-2xl text-white placeholder-white/80 focus:outline-none focus:border-white focus:ring-2 focus:ring-white/30 transition-all"
                        />
                    </div>

                    <div>
                        <label for="passwordConfirm" class="sr-only"
                            >Confirmer le mot de passe</label
                        >
                        <input
                            type="password"
                            id="passwordConfirm"
                            placeholder="Confirmer le mot de passe"
                            required
                            minlength="8"
                            class="w-full px-4 py-3.5 bg-white/10 border-2 border-white/80 rounded-2xl text-white placeholder-white/80 focus:outline-none focus:border-white focus:ring-2 focus:ring-white/30 transition-all"
                        />
                    </div>
                </div>

                <div class="pt-2">
                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-white text-blue font-bold py-3.5 px-4 rounded-2xl text-lg shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-95 disabled:opacity-70 disabled:cursor-not-allowed"
                    >
                        S'inscrire
                    </button>
                </div>
            </form>

            <div class="h-10 mt-4 text-center flex items-center justify-center">
                <p
                    id="error-message"
                    class="text-red-100 font-medium text-sm leading-tight"
                    aria-live="polite"
                >
                </p>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { pb } from "../lib/pocketbase";

    document.addEventListener("DOMContentLoaded", () => {
        // Éléments du DOM
        const form = document.getElementById(
            "register-form",
        ) as HTMLFormElement;
        const errorMessage = document.getElementById("error-message");
        const submitBtn = document.getElementById(
            "submit-btn",
        ) as HTMLButtonElement;

        const avatarInput = document.getElementById(
            "avatar",
        ) as HTMLInputElement;
        const avatarPreview = document.getElementById(
            "avatar-preview",
        ) as HTMLImageElement;
        const avatarPlaceholder = document.getElementById("avatar-placeholder");

        const emailInput = document.getElementById("email") as HTMLInputElement;
        const pseudoInput = document.getElementById(
            "pseudo",
        ) as HTMLInputElement;
        const passwordInput = document.getElementById(
            "password",
        ) as HTMLInputElement;
        const passwordConfirmInput = document.getElementById(
            "passwordConfirm",
        ) as HTMLInputElement;

        if (!form || !errorMessage || !submitBtn) return;

        if (avatarInput && avatarPreview && avatarPlaceholder) {
            avatarInput.addEventListener("change", () => {
                const file = avatarInput.files?.[0];

                if (!file) {
                    avatarPreview.removeAttribute("src");
                    avatarPreview.classList.add("hidden");
                    avatarPlaceholder.classList.remove("hidden");
                    return;
                }

                const previewUrl = URL.createObjectURL(file);
                avatarPreview.src = previewUrl;
                avatarPreview.classList.remove("hidden");
                avatarPlaceholder.classList.add("hidden");

                avatarPreview.onload = () => URL.revokeObjectURL(previewUrl);
            });
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            errorMessage.textContent = "";
            submitBtn.disabled = true;
            const originalBtnText = submitBtn.textContent || "S'inscrire";
            submitBtn.textContent = "Création du compte...";

            const email = emailInput.value.trim();
            const pseudo = pseudoInput.value.trim();
            const password = passwordInput.value;
            const passwordConfirm = passwordConfirmInput.value;
            const avatarFile = avatarInput.files?.[0];

            const showError = (msg: string) => {
                errorMessage.textContent = msg;
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
            };

            if (!/^\S+@\S+\.\S+$/.test(email))
                return showError("Adresse e-mail invalide.");
            if (pseudo.length < 2)
                return showError(
                    "Le pseudo doit contenir au moins 2 caractères.",
                );
            if (password.length < 8)
                return showError(
                    "Le mot de passe doit contenir au moins 8 caractères.",
                );
            if (password !== passwordConfirm)
                return showError("Les mots de passe ne correspondent pas.");
            if (avatarFile && avatarFile.size > 5 * 1024 * 1024)
                return showError("La photo est trop volumineuse (max 5 Mo).");

            const data = new FormData();
            data.append("email", email);
            data.append("pseudo", pseudo);
            data.append("password", password);
            data.append("passwordConfirm", passwordConfirm);
            if (avatarFile) data.append("avatar", avatarFile);

            try {
                await pb.collection("users").create(data);
                await pb.collection("users").authWithPassword(email, password);
                document.cookie = pb.authStore.exportToCookie({
                    httpOnly: false,
                    secure: true,
                    sameSite: "Lax",
                });

                window.location.href = "/accueil";
            } catch (err: any) {
                console.error("Échec de l'inscription :", err);

                let msg = "Une erreur est survenue lors de l'inscription.";
                const pbData = err?.response?.data || {};

                if (pbData.email)
                    msg = "Cette adresse e-mail est déjà utilisée ou invalide.";
                else if (pbData.pseudo || pbData.username)
                    msg = "Ce pseudo est déjà pris.";
                else if (pbData.password)
                    msg =
                        "Le mot de passe ne respecte pas les critères de sécurité.";
                else if (pbData.avatar)
                    msg = "La photo de profil est invalide.";

                showError(msg);
            }
        });
    });
</script>
