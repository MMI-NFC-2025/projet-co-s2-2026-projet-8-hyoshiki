---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main style="background-color: var(--blue);" class="flex flex-col items-center justify-center w-full min-h-screen p-6">
        <div class="w-full max-w-sm bg-white rounded-3xl shadow-xl p-8 text-center border border-slate-100">
            
            <h1 class="text-3xl font-extrabold text-slate-800 mb-4">Passez Premium</h1>
            <p class="text-slate-600 mb-8 leading-relaxed">
                Débloquez l'accès complet au <b>Chapitre 2</b> et à toutes nos aventures exclusives pour continuer votre progression !
            </p>

            <div class="space-y-4">
                <button class="w-full py-4 bg-cyan-400 text-white font-bold rounded-2xl shadow-lg transition-transform hover:scale-[1.02]">
                    S'abonner pour 4,99€
                </button>
                
                <a href="/aventure" class="block w-full py-4 bg-slate-100 text-slate-600 font-bold rounded-2xl transition-colors hover:bg-slate-200">
                    Retour aux aventures
                </a>
            </div>
            
            <p class="text-xs text-slate-400 mt-8">
                Paiement sécurisé. Accès immédiat après achat.
            </p>
        </div>
    </main>
</Layout>